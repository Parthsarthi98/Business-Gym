# Copy this file to .env.local for local development. Never commit .env.local.
# On Vercel, set the same names under Project Settings -> Environment Variables.

# Required. Plays the buyer and the coach. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Required for voice. Streaming speech-to-text. https://console.deepgram.com
# The key needs the "Member" role or higher so it can mint short-lived browser tokens.
DEEPGRAM_API_KEY=

# Required for voice. Text-to-speech (Sarvam Bulbul). https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Required. A passphrase you choose. The app asks for it once and stores it on your phone.
# It stops anyone who finds your URL from spending your API credit.
APP_ACCESS_CODE=
